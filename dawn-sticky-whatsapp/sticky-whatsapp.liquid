{% comment %}
  Zelfstandige sticky WhatsApp-knop voor het reguliere Dawn-thema.
  Geen afhankelijkheden van dit Horizon-conceptthema: gewone Liquid, HTML en CSS.

  Installatie in Shopify admin:
  1. Online Store > Thema's > (je live Dawn-thema) > "..." > Code bewerken.
  2. Klik bij "Snippets" op "Nieuwe snippet toevoegen", noem 'm: sticky-whatsapp
  3. Plak de hele inhoud van dit bestand erin en klik op Opslaan.
  4. Open "Layout" > theme.liquid, zoek de regel </body> en plak
     {% render 'sticky-whatsapp' %}
     direct erboven. Opslaan.
  5. Pas hieronder je telefoonnummer en bericht aan.
{% endcomment %}

{%- liquid
  assign whatsapp_number = '31612993707'
  assign whatsapp_message = 'Hoi Vinami! Ik heb een vraag over jullie wijnen.'
  assign whatsapp_label = 'Vraag over wijn?'
-%}

<a
  href="https://wa.me/{{ whatsapp_number }}?text={{ whatsapp_message | url_encode }}"
  class="vinami-whatsapp-fab"
  target="_blank"
  rel="noopener"
  aria-label="Stuur ons een WhatsApp-bericht"
>
  <svg class="vinami-whatsapp-fab__icon" viewBox="0 0 32 32" fill="none" xmlns="http://www.w3.org/2000/svg" aria-hidden="true">
    <path d="M16 4C9.4 4 4 9.4 4 16c0 2.2.6 4.3 1.7 6.1L4 28l6.1-1.6A11.9 11.9 0 0 0 16 28c6.6 0 12-5.4 12-12S22.6 4 16 4Z" stroke="white" stroke-width="2"/>
    <path d="M11 15.2c1.4 3 3.8 5.3 6.8 6.6.9.4 1.7.3 2.4-.1.5-.3.9-.8 1-1.3.1-.3 0-.6-.3-.8l-2-1.4c-.3-.2-.6-.2-.9 0l-.7.6c-.2.2-.5.2-.8 0-1-.6-1.9-1.5-2.5-2.5-.2-.3-.2-.6 0-.8l.6-.7c.2-.3.2-.6 0-.9l-1.4-2c-.2-.3-.5-.4-.8-.3-.6.1-1 .5-1.3 1-.4.7-.5 1.5-.1 2.4Z" fill="white"/>
  </svg>
  <span class="vinami-whatsapp-fab__label">{{ whatsapp_label }}</span>
</a>

<style>
  .vinami-whatsapp-fab {
    position: fixed;
    right: max(20px, env(safe-area-inset-right));
    bottom: max(20px, env(safe-area-inset-bottom));
    z-index: 100;
    display: flex;
    align-items: center;
    gap: 0.6rem;
    height: 52px;
    padding-inline: 0.9rem;
    border-radius: 999px;
    background: #25d366;
    color: #fff;
    box-shadow: 0 6px 18px rgba(20, 18, 15, 0.28);
    text-decoration: none;
    transition: transform 0.15s ease;
  }

  .vinami-whatsapp-fab:hover,
  .vinami-whatsapp-fab:focus-visible {
    transform: scale(1.05);
    color: #fff;
  }

  .vinami-whatsapp-fab__icon {
    flex: 0 0 auto;
    width: 26px;
    height: 26px;
  }

  .vinami-whatsapp-fab__label {
    font-family: inherit;
    font-size: 0.9rem;
    font-weight: 600;
    white-space: nowrap;
  }

  @media screen and (max-width: 749px) {
    .vinami-whatsapp-fab {
      right: max(16px, env(safe-area-inset-right));
      bottom: max(16px, env(safe-area-inset-bottom));
      height: 48px;
      padding-inline: 0;
      width: 48px;
      justify-content: center;
    }

    .vinami-whatsapp-fab__label {
      display: none;
    }
  }
</style>
